{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "raster-TS/**/*.ts",
    "terrain-TS/**/*.ts",
    "ground-TS/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "src/**/*.tsx",
    "tests/**/*.tsx"
  ]
}
